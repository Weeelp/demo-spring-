<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">

    <Properties>
        <property name="LOG_DIR">logs</property>
        <property name="ARCHIVE_LOG_DIR">${LOG_DIR}/archive</property>
        <property name="pattern_file">%d [%t] %-5level %logger{5} - %msg%n</property>
        <!--        <Property name="console.thresholdFilter">${bundle:application:logger.console.tresholdFilter}</Property>-->
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
<!--         <ThresholdFilter level="${console.thresholdFilter}"/>-->
            <PatternLayout pattern="%d{HH:mm:ss} %-5p [%t] %logger{7} - %m%n"/>
        </Console>

        <RollingFile name="FileRolling" filename="${LOG_DIR}/text_log.log" append="true"
                     filePattern="${LOG_DIR}/${date:yyyy-MM-dd}/%d{yyyy-MM-dd_HH-mm}_%i.log">
            <PatternLayout pattern="${pattern_file}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10KB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileRolling"/>
        </Root>
    </Loggers>
</Configuration>
